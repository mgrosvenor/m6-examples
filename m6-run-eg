#!/bin/bash
# m6-run-eg — start, restart, rebuild, reload, or stop an m6 example's dev stack.
#
# Usage:
#   m6-run-eg                      interactive prompt
#   m6-run-eg <N>                  start example N, or reload config if already running
#   m6-run-eg <N> start            start example N
#   m6-run-eg <N> restart          kill all services, then start fresh
#   m6-run-eg <N> rebuild          run make/cargo build, then touch site.toml
#   m6-run-eg <N> reload           touch site.toml only (no build, no restart)
#   m6-run-eg <N> stop             stop example N
#
# Examples live in examples/<NN>-<name>/dev.sh
# Each dev stack owns a pgid stored in /tmp/m6-eg/<NN>.pgid

set -euo pipefail

EXAMPLES_DIR="$(cd "$(dirname "$0")/examples" && pwd)"
PGID_DIR="/tmp/m6-eg"
PORT=8443

# ── helpers ──────────────────────────────────────────────────────────────────

die() { echo "error: $*" >&2; exit 1; }

# Map example number → directory (accepts "1", "01", "2", "05", etc.)
find_eg_dir() {
    local num
    num=$(printf "%02d" "$1" 2>/dev/null) || die "invalid example number: $1"
    local dir
    dir=$(find "$EXAMPLES_DIR" -maxdepth 1 -type d -name "${num}-*" | head -1)
    [ -n "$dir" ] || die "no example directory matching ${num}-*"
    echo "$dir"
}

# Return the stored pgid for a running example, or empty string.
running_pgid() {
    local num
    num=$(printf "%02d" "$1")
    local f="$PGID_DIR/${num}.pgid"
    [ -f "$f" ] || { echo ""; return; }
    local pg
    pg=$(cat "$f")
    if kill -0 -- "-$pg" 2>/dev/null; then
        echo "$pg"
    else
        rm -f "$f"
        echo ""
    fi
}

# Kill a process group by pgid and wait for it to exit.
kill_eg() {
    local num
    num=$(printf "%02d" "$1")
    local pg
    pg=$(running_pgid "$num")
    if [ -n "$pg" ]; then
        echo "stopping example $num (pgid $pg)..."
        kill -- "-$pg" 2>/dev/null || true
        local i=0
        while kill -0 -- "-$pg" 2>/dev/null && [ $i -lt 30 ]; do
            sleep 0.1; i=$((i+1))
        done
        kill -9 -- "-$pg" 2>/dev/null || true
        rm -f "$PGID_DIR/${num}.pgid"
        echo "stopped."
    else
        echo "example $num is not running."
    fi
}

# Start an example in a new process group.
start_eg() {
    local num
    num=$(printf "%02d" "$1")
    local dir
    dir=$(find_eg_dir "$1")
    local dev_sh="$dir/dev.sh"
    [ -f "$dev_sh" ] || die "no dev.sh in $dir"

    mkdir -p "$PGID_DIR"

    # Stop any other running examples first.
    for pgid_file in "$PGID_DIR"/*.pgid; do
        [ -f "$pgid_file" ] || continue
        local other
        other=$(basename "$pgid_file" .pgid)
        [ "$other" = "$num" ] && continue
        local other_n
        other_n=$((10#$other))
        pg=$(running_pgid "$other_n")
        [ -n "$pg" ] && kill_eg "$other_n"
    done

    # Clear port (dev.sh does this too, but ensure a clean start).
    lsof -ti ":$PORT" 2>/dev/null | xargs kill -9 2>/dev/null || true
    sleep 0.3

    echo "starting example $num ($(basename "$dir"))..."

    # setsid puts the child in a new session so we can kill the whole group cleanly.
    setsid bash "$dev_sh" &>/tmp/m6-eg-${num}.log &
    local pg=$!
    echo "$pg" > "$PGID_DIR/${num}.pgid"

    echo "pgid $pg — log: /tmp/m6-eg-${num}.log"
    echo "waiting for port $PORT..."
    local i=0
    while ! lsof -ti ":$PORT" &>/dev/null && [ $i -lt 50 ]; do
        sleep 0.2; i=$((i+1))
    done
    if lsof -ti ":$PORT" &>/dev/null; then
        echo "up. $(date '+%H:%M:%S')"
    else
        echo "port $PORT not open after 10s — check /tmp/m6-eg-${num}.log"
    fi
}

# Touch site.toml to trigger m6-html hot-reload (no rebuild, no restart).
reload_eg() {
    local dir
    dir=$(find_eg_dir "$1")
    local toml="$dir/site.toml"
    [ -f "$toml" ] || { echo "no site.toml in $dir — nothing to reload"; return; }
    touch "$toml"
    echo "reloaded: touched $toml"
}

# Rebuild the example (Makefile, cargo package, or no-op), then reload.
rebuild_eg() {
    local dir
    dir=$(find_eg_dir "$1")
    local built=0

    # 1. Makefile in the example directory.
    if [ -f "$dir/Makefile" ]; then
        echo "running: make -C $dir"
        make -C "$dir"
        built=1
    fi

    # 2. Any Cargo.toml sub-packages under the example directory.
    while IFS= read -r cargo_toml; do
        local pkg_dir
        pkg_dir=$(dirname "$cargo_toml")
        local pkg_name
        pkg_name=$(grep '^name' "$cargo_toml" | head -1 | sed 's/.*= *"\(.*\)"/\1/')
        if [ -n "$pkg_name" ]; then
            echo "running: cargo build --release -p $pkg_name"
            (cd "$EXAMPLES_DIR/.." && cargo build --release -p "$pkg_name")
            built=1
        fi
    done < <(find "$dir" -maxdepth 2 -name "Cargo.toml" ! -path "$dir/Cargo.toml")

    if [ "$built" -eq 0 ]; then
        echo "nothing to build in $(basename "$dir")"
    fi

    # Always reload config after a rebuild.
    reload_eg "$1"
}

# List all examples with running status.
list_examples() {
    echo ""
    printf "  %-4s  %-32s  %s\n" "NUM" "EXAMPLE" "STATUS"
    printf "  %-4s  %-32s  %s\n" "---" "-------" "------"
    for dir in "$EXAMPLES_DIR"/[0-9][0-9]-*/; do
        [ -d "$dir" ] || continue
        local name
        name=$(basename "$dir")
        local num="${name%%-*}"
        local n
        n=$((10#$num))
        local status="stopped"
        local pg
        pg=$(running_pgid "$n")
        [ -n "$pg" ] && status="running (pgid $pg)"
        local has_dev=""
        [ -f "$dir/dev.sh" ] || has_dev=" [no dev.sh]"
        printf "  %-4s  %-32s  %s%s\n" "$num" "$name" "$status" "$has_dev"
    done
    echo ""
}

# Interactive prompt.
interactive() {
    list_examples
    read -r -p "example number> " num
    [ -z "$num" ] && exit 0
    local pg
    pg=$(running_pgid "$num" 2>/dev/null || echo "")
    if [ -n "$pg" ]; then
        echo ""
        echo "example $num is running (pgid $pg)."
        read -r -p "[restart/rebuild/reload/stop/cancel]> " action
        case "$(echo "${action:-cancel}" | tr '[:upper:]' '[:lower:]')" in
            restart) kill_eg "$num"; start_eg "$num" ;;
            rebuild) rebuild_eg "$num" ;;
            reload)  reload_eg "$num" ;;
            stop)    kill_eg "$num" ;;
            *)       echo "cancelled." ;;
        esac
    else
        start_eg "$num"
    fi
}

# ── main ─────────────────────────────────────────────────────────────────────

NUM="${1:-}"
ACTION="${2:-}"

if [ -z "$NUM" ]; then
    interactive
    exit 0
fi

re='^[0-9]+$'
[[ "$NUM" =~ $re ]] || die "example number must be a digit, got: $NUM"

# Default: start if stopped, reload if running.
if [ -z "$ACTION" ]; then
    pg=$(running_pgid "$NUM" 2>/dev/null || echo "")
    if [ -n "$pg" ]; then
        ACTION="reload"
    else
        ACTION="start"
    fi
fi

case "$(echo "$ACTION" | tr '[:upper:]' '[:lower:]')" in
    start)   start_eg "$NUM" ;;
    restart) kill_eg "$NUM"; start_eg "$NUM" ;;
    rebuild) rebuild_eg "$NUM" ;;
    reload)  reload_eg "$NUM" ;;
    stop)    kill_eg "$NUM" ;;
    *)       die "unknown action '$ACTION' — expected start, restart, rebuild, reload, or stop" ;;
esac
