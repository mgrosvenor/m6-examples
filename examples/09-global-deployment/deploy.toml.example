# deploy.toml — node addresses for deploy.sh and invalidate-cache.sh.
# Copy to deploy.toml and fill in your actual SSH targets.
# deploy.toml is listed in site-gitignore so it stays off version control.

[deploy]
origin   = "root@syd.example.com"   # SSH target for Sydney origin
site_dir = "/var/www/my-blog"       # path on every node
ssh_opts = "-o StrictHostKeyChecking=accept-new -o ConnectTimeout=15"

[cache_nodes]
sf        = "root@sf.example.com"
nyc       = "root@nyc.example.com"
chicago   = "root@chi.example.com"
london    = "root@lon.example.com"
singapore = "root@sin.example.com"
