# .gitignore for an m6 site repository
#
# This file shows what to EXCLUDE from version control.
# Copy to your site root as .gitignore.

# ── Server-managed state ───────────────────────────────────────────────────────
# These are generated or managed on the server; deploying would overwrite them.
data/auth.db          # user accounts and sessions — server-managed
data/posts.json       # generated by m6-md on deploy from content/posts/
content/drafts/       # in-progress drafts — server-managed by CMS
logs/                 # runtime log files

# ── Secrets and private keys ───────────────────────────────────────────────────
keys/                 # auth signing keys (NEVER commit)
*.pem                 # TLS certificates and private keys
*.pub                 # public keys (safe but not needed in repo)
certs/                # local dev TLS certs (mkcert)

# ── Build artefacts ────────────────────────────────────────────────────────────
target/               # Rust build output
bin/                  # deployed renderer binaries (push with --binary flag)

# ── Deploy config (contains server addresses) ─────────────────────────────────
deploy.toml           # copy of deploy.toml.example with real addresses

# ── Dev scratch ────────────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
